   private
 
+  # A user-owned task is cancelled only by its linked Slack author, from its
+  # delivery channel or a DM. A channel-owned task belongs to the channel, whose
+  # members already manage it from channel threads, so a click from that channel
+  # in its workspace is enough.
+  def slack_cancellation_allowed?(team_id:, user_id:, channel_id:)
+    if principal
+      return principal.slack_team_id == team_id &&
+        principal.slack_channel_id == channel_id && delivery_channel == channel_id
+    end
+    return false unless author&.active?
+
+    policy = SlackDeliveryPolicy.new(author)
+    destination_matches = delivery_channel == channel_id ||
+      (delivery_channel == user_id && channel_id.start_with?("D"))
+    policy.slack_team_id == team_id && policy.slack_user_id == user_id && destination_matches
+  end
