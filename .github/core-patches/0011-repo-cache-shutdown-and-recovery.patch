+            self.git("-C", str(self.target), "rev-parse", "HEAD"), expected
+        )
+        self.assertEqual(self.git("-C", str(self.target), "rev-parse", "v1"), expected)
+        self.assertEqual(self.sync.check_ready(), 0)
