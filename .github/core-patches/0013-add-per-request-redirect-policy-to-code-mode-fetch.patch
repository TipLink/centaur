+        let hits = RedirectHits::default();
+        let app = axum::Router::new()
+            .route(
+                "/redirect/{status}",
+                any(
+                    |State(hits): State<RedirectHits>, Path(status): Path<u16>| async move {
+                        hits.initial.fetch_add(1, Ordering::SeqCst);
+                        (
+                            StatusCode::from_u16(status).unwrap(),
+                            [("location", "/target?token=private")],
