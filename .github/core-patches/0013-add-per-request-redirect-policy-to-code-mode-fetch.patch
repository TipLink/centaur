+#[derive(Clone, Copy, PartialEq, Eq)]
+enum RedirectPolicy {
+    Follow,
+    Error,
+}
+
+impl<'js> FromJs<'js> for RedirectPolicy {
+    fn from_js(ctx: &Ctx<'js>, value: Value<'js>) -> rquickjs::Result<Self> {
+        if value.is_undefined() {
+            return Ok(Self::Follow);
+        }
+        match String::from_js(ctx, value).as_deref() {
+            Ok("follow") => Ok(Self::Follow),
+            Ok("error") => Ok(Self::Error),
+            _ => Err(Exception::throw_type(
+                ctx,
+                "redirect must be 'follow' or 'error'",
+            )),
+        }
+    }
+}
+
+impl RedirectPolicy {
+    fn client(self, cell: &Cell) -> &reqwest::Client {
+        match self {
+            Self::Follow => &cell.http,
+            Self::Error => &cell.http_no_redirect,
+        }
+    }
+
+    fn refuses(self, response: &reqwest::Response) -> bool {
+        self == Self::Error && response.status().is_redirection()
+    }
+}
