+/** Exercise redirect handling and report the exception seen by the connector. */
+export async function redirect(args: { url: string; init?: any; download?: boolean }, ctx: Ctx): Promise<unknown> {
+  try {
+    if (args.download) return await ctx.files!.download(args.url, "download.txt", args.init);
+    const res = await ctx.fetch(args.url, args.init);
+    return await res.text();
+  } catch (e) {
+    return { message: e.message, typeError: e instanceof TypeError };
+  }
+}
