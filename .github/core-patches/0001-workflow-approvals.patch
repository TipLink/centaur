+use super::*;
+use sqlx::Row;
+
+pub(crate) struct Repository {
+    pub pool: PgPool,
+    pub policies: Arc<Policies>,
+}
+
+#[derive(sqlx::FromRow)]
+pub(crate) struct Record {
+    pub id: Uuid,
+    pub action: String,
+    pub policy_hash: String,
+    pub payload: Value,
+    pub payload_hash: String,
+    pub payload_json: String,
+    pub team_id: String,
