+        .execute(&pool)
+        .await
+        .unwrap();
+    let mut wrong_policy = public_policy.clone();
+    wrong_policy.public_result_fields.push("credential".into());
+    repo.finish(id, &wrong_policy, hello()).await.unwrap();
+    assert_eq!(
+        repo.read(id, identity()).await.unwrap()["status"],
+        "executing"
+    );
